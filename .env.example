# Copy to .env and fill locally. Never commit .env or paste secrets into chat, docs, or source.

# Qloo (hackathon keys only work on hackathon.api.qloo.com)
QLOO_API_KEY=replace-with-your-qloo-hackathon-key
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=30
QLOO_MAX_RETRIES=2
QLOO_RETRY_BACKOFF_SECONDS=0.5

# Primary LLM — OpenAI-compatible (planned: Mistral free tier)
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=replace-with-your-mistral-key
LLM_MODEL=mistral-small-latest

# Fallback LLM — OpenAI-compatible (planned: OpenRouter free models)
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=replace-with-your-openrouter-key
LLM_FALLBACK_MODEL=openrouter/free
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MIN_REQUEST_INTERVAL_SECONDS=1
LLM_INVALID_OUTPUT_RETRIES=1

# Optional OpenRouter identification (not a secret; still do not invent values)
LLM_HTTP_REFERER=http://localhost:3000
LLM_APP_TITLE=Vyuha

# Backend runtime
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=1048576
LOG_LEVEL=INFO
