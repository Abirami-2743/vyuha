# Copy to .env and fill locally. Never commit .env or paste secrets into chat, docs, or source.

# Qloo (hackathon keys only work on hackathon.api.qloo.com)
QLOO_API_KEY=replace-with-your-qloo-hackathon-key
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=30
QLOO_MAX_RETRIES=2
QLOO_RETRY_BACKOFF_SECONDS=0.5

# Primary LLM — Groq OpenAI-compatible API
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-your-groq-key
LLM_MODEL=llama-3.3-70b-versatile

# Fallback LLM — Mistral OpenAI-compatible API
LLM_FALLBACK_BASE_URL=https://api.mistral.ai/v1
LLM_FALLBACK_API_KEY=replace-with-your-mistral-key
LLM_FALLBACK_MODEL=mistral-small-latest
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MIN_REQUEST_INTERVAL_SECONDS=1
LLM_INVALID_OUTPUT_RETRIES=1

# Optional client attribution (not a secret)
LLM_HTTP_REFERER=http://localhost:3000
LLM_APP_TITLE=Vyuha

# Backend runtime
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BYTES=1048576
ANALYSIS_PER_IP_DAILY_LIMIT=100
ANALYSIS_DAILY_LIMIT=1000
VYUHA_SAVED_RUN_PATH=.vyuha-private/saved-run.json
VYUHA_SAVED_RUN_OUTPUT_PATH=.vyuha-private/saved-run.json
VYUHA_SAVED_RUNS_DIR=.vyuha-private/demo-runs
LOG_LEVEL=INFO

# Uvicorn proxy trust (Render overrides this to "*" behind its managed proxy)
FORWARDED_ALLOW_IPS=127.0.0.1
